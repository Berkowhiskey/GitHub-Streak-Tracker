# ---------------------------------------------------------------------------
# StreakTracker - ortam degiskenleri sablonu
#
# Bu dosyayi ".env" adiyla kopyalayip degerleri doldurun.
# ".env" .gitignore'dadir ve ASLA commit'lenmemelidir.
#
# Sunucuda olusturduktan sonra izinleri kisitlayin:  chmod 600 .env
# ---------------------------------------------------------------------------

# --- Yerel gelistirme veritabani (docker-compose.yml) ---
POSTGRES_DB=streaktracker
POSTGRES_USER=streaktracker
POSTGRES_PASSWORD=degistirin-guclu-bir-sifre
POSTGRES_PORT=5434

# --- Production veritabani: Supabase (docker-compose.prod.yml) ---
# Supabase panelinde: Connect -> Connection string -> "Session pooler" sekmesi
#
# ONEMLI: Port 5432 (session mode) kullanilmali. Transaction mode (6543)
# prepared statement desteklemez ve EF Core / Hangfire bozulur.
# Ayrica "pooler" adresi kullanilmali; dogrudan baglanti IPv6-only'dir.
SUPABASE_DB_HOST=aws-0-eu-west-1.pooler.supabase.com
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.projeref
SUPABASE_DB_PASSWORD=supabase-veritabani-sifresi

# --- Alan adi (production) ---
# Caddy SSL sertifikasini bu adres icin alir.
API_DOMAIN=api.ornek-alan-adi.com

# --- Uygulama adresleri (production) ---
APP_PUBLIC_BASE_URL=https://api.ornek-alan-adi.com
APP_FRONTEND_BASE_URL=https://ornek-alan-adi.com
CORS_ALLOWED_ORIGIN=https://ornek-alan-adi.com

# Frontend ve API ayni site altindaysa (site.com + api.site.com) -> Lax
# Farkli alan adlarindaysa (orn. *.vercel.app + api.site.com)      -> None
APP_COOKIE_SAMESITE=Lax

# --- Kimlik dogrulama ---
# En az 32 bayt olmali:  openssl rand -base64 48
JWT_KEY=degistirin-en-az-32-baytlik-rastgele-anahtar

# --- GitHub OAuth App (production icin ayri bir App olusturun) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App (bildirimleri bot kimligiyle gonderir) ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# .pem dosyasi secrets/ klasorune konur ve container'a salt okunur baglanir.
GITHUB_APP_PRIVATE_KEY_FILE=streaktracker.private-key.pem
